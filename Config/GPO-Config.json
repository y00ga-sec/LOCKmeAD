{
  "Settings": {
    "LogDirectory": "./Logs",
    "FilteringGroupsOU": "OU=GPO,OU=GroupsT0,OU=Admin,DC=forest,DC=lol"
  },
  "GPOs": [
    {
      "Name": "SEC-Disable-NTLMv1",
      "Description": "Enforce NTLMv2-only authentication, refuse LM and NTLMv1 responses",
      "Enabled": true,
      "LinkTargets": null,
      "RegistrySettings": [
        {
          "Key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa",
          "ValueName": "LmCompatibilityLevel",
          "Value": 5,
          "Type": "DWord",
          "Description": "Send NTLMv2 response only, refuse LM and NTLM"
        }
      ]
    },
    {
      "Name": "SEC-Disable-LMHash",
      "Description": "Prevent storage of LAN Manager password hashes on next password change",
      "Enabled": true,
      "LinkTargets": null,
      "RegistrySettings": [
        {
          "Key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa",
          "ValueName": "NoLMHash",
          "Value": 1,
          "Type": "DWord",
          "Description": "Do not store LAN Manager hash value on next password change"
        }
      ]
    },
    {
      "Name": "SEC-Disable-LLMNR",
      "Description": "Disable Link-Local Multicast Name Resolution to prevent LLMNR poisoning attacks",
      "Enabled": true,
      "LinkTargets": null,
      "RegistrySettings": [
        {
          "Key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\DNSClient",
          "ValueName": "EnableMulticast",
          "Value": 0,
          "Type": "DWord",
          "Description": "Turn off multicast name resolution (LLMNR)"
        }
      ]
    },
    {
      "Name": "SEC-Disable-mDNS",
      "Description": "Disable Multicast DNS to prevent mDNS poisoning attacks",
      "Enabled": true,
      "LinkTargets": null,
      "RegistrySettings": [
        {
          "Key": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\Dnscache\\Parameters",
          "ValueName": "EnableMDNS",
          "Value": 0,
          "Type": "DWord",
          "Description": "Disable mDNS client"
        }
      ]
    },
    {
      "Name": "SEC-Disable-NBT-NS",
      "Description": "Disable NetBIOS over TCP/IP name resolution to prevent NBT-NS poisoning attacks",
      "Enabled": true,
      "LinkTargets": null,
      "RegistrySettings": [
        {
          "Key": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\NetBT\\Parameters",
          "ValueName": "NodeType",
          "Value": 2,
          "Type": "DWord",
          "Description": "Set P-node (peer-to-peer) to disable NetBIOS broadcast name resolution"
        }
      ]
    },
    {
      "Name": "SEC-Disable-Wdigest",
      "Description": "Disable WDigest authentication to prevent cleartext credential caching in memory",
      "Enabled": true,
      "LinkTargets": null,
      "RegistrySettings": [
        {
          "Key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\WDigest",
          "ValueName": "UseLogonCredential",
          "Value": 0,
          "Type": "DWord",
          "Description": "Disable WDigest credential caching"
        }
      ]
    },
    {
      "Name": "SEC-Disable-SMBv1",
      "Description": "Disable SMBv1 protocol (server and client) to prevent EternalBlue-class attacks",
      "Enabled": true,
      "LinkTargets": null,
      "RegistrySettings": [
        {
          "Key": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters",
          "ValueName": "SMB1",
          "Value": 0,
          "Type": "DWord",
          "Description": "Disable SMBv1 server"
        },
        {
          "Key": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\mrxsmb10",
          "ValueName": "Start",
          "Value": 4,
          "Type": "DWord",
          "Description": "Disable SMBv1 client driver (4 = Disabled)"
        }
      ]
    },
    {
      "Name": "SEC-Require-SMBSigning",
      "Description": "Require SMB packet signing on both server and client to prevent relay attacks",
      "Enabled": true,
      "LinkTargets": null,
      "RegistrySettings": [
        {
          "Key": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters",
          "ValueName": "RequireSecuritySignature",
          "Value": 1,
          "Type": "DWord",
          "Description": "Require SMB signing on server"
        },
        {
          "Key": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanmanWorkstation\\Parameters",
          "ValueName": "RequireSecuritySignature",
          "Value": 1,
          "Type": "DWord",
          "Description": "Require SMB signing on client"
        }
      ]
    },
    {
      "Name": "SEC-Disable-Autorun",
      "Description": "Disable AutoRun and AutoPlay to prevent automatic execution of removable media",
      "Enabled": true,
      "LinkTargets": null,
      "RegistrySettings": [
        {
          "Key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer",
          "ValueName": "NoDriveTypeAutoRun",
          "Value": 255,
          "Type": "DWord",
          "Description": "Disable autorun for all drive types"
        },
        {
          "Key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer",
          "ValueName": "NoAutorun",
          "Value": 1,
          "Type": "DWord",
          "Description": "Disable default autorun behavior"
        },
        {
          "Key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\Explorer",
          "ValueName": "NoAutoplayfornonVolume",
          "Value": 1,
          "Type": "DWord",
          "Description": "Disable autoplay for non-volume devices"
        }
      ]
    },
    {
      "Name": "SEC-Disable-WSH",
      "Description": "Disable Windows Script Host to block execution of VBS, JS, and WSF scripts",
      "Enabled": false,
      "LinkTargets": null,
      "RegistrySettings": [
        {
          "Key": "HKLM\\SOFTWARE\\Microsoft\\Windows Script Host\\Settings",
          "ValueName": "Enabled",
          "Value": 0,
          "Type": "DWord",
          "Description": "Disable Windows Script Host"
        }
      ]
    },
    {
      "Name": "SEC-Tiering-T0-DenyLogon",
      "Description": "Deny all logon types to Tier 0 assets for T1 and T2 accounts - link to T0-Prod OUs",
      "Enabled": true,
      "LinkTargets": "OU=T0-Prod,DC=forest,DC=lol",
      "UserRightsAssignments": [
        {
          "Right": "SeDenyInteractiveLogonRight",
          "Description": "Deny log on locally",
          "Groups": [
            "DL_T1",
            "DL_T2"
          ]
        },
        {
          "Right": "SeDenyRemoteInteractiveLogonRight",
          "Description": "Deny log on through Remote Desktop",
          "Groups": [
            "DL_T1",
            "DL_T2"
          ]
        },
        {
          "Right": "SeDenyNetworkLogonRight",
          "Description": "Deny access from the network",
          "Groups": [
            "DL_T1",
            "DL_T2"
          ]
        },
        {
          "Right": "SeDenyBatchLogonRight",
          "Description": "Deny log on as a batch job",
          "Groups": [
            "DL_T1",
            "DL_T2"
          ]
        },
        {
          "Right": "SeDenyServiceLogonRight",
          "Description": "Deny log on as a service",
          "Groups": [
            "DL_T1",
            "DL_T2"
          ]
        }
      ]
    },
    {
      "Name": "SEC-Tiering-T1-DenyLogon",
      "Description": "Deny all logon types to Tier 1 assets for T0, T2, and privileged AD groups - link to T1-Prod OUs",
      "Enabled": true,
      "LinkTargets": "OU=Servers,OU=T1-Prod,DC=forest,DC=lol",
      "UserRightsAssignments": [
        {
          "Right": "SeDenyInteractiveLogonRight",
          "Description": "Deny log on locally",
          "Groups": [
            "DL_T0",
            "DL_T2",
            "Domain Admins",
            "Enterprise Admins",
            "Schema Admins",
            "DnsAdmins"
          ]
        },
        {
          "Right": "SeDenyRemoteInteractiveLogonRight",
          "Description": "Deny log on through Remote Desktop",
          "Groups": [
            "DL_T0",
            "DL_T2",
            "Domain Admins",
            "Enterprise Admins",
            "Schema Admins",
            "DnsAdmins"
          ]
        },
        {
          "Right": "SeDenyNetworkLogonRight",
          "Description": "Deny access from the network",
          "Groups": [
            "DL_T0",
            "DL_T2",
            "Domain Admins",
            "Enterprise Admins",
            "Schema Admins",
            "DnsAdmins"
          ]
        },
        {
          "Right": "SeDenyBatchLogonRight",
          "Description": "Deny log on as a batch job",
          "Groups": [
            "DL_T0",
            "DL_T2",
            "Domain Admins",
            "Enterprise Admins",
            "Schema Admins",
            "DnsAdmins"
          ]
        },
        {
          "Right": "SeDenyServiceLogonRight",
          "Description": "Deny log on as a service",
          "Groups": [
            "DL_T0",
            "DL_T2",
            "Domain Admins",
            "Enterprise Admins",
            "Schema Admins",
            "DnsAdmins"
          ]
        }
      ]
    },
    {
      "Name": "SEC-Tiering-T2-DenyLogon",
      "Description": "Deny all logon types to Tier 2 assets for T0, T1, and privileged AD groups - link to T2-Prod OUs",
      "Enabled": true,
      "LinkTargets": "OU=Workstations,OU=T2-Prod,DC=forest,DC=lol",
      "UserRightsAssignments": [
        {
          "Right": "SeDenyInteractiveLogonRight",
          "Description": "Deny log on locally",
          "Groups": [
            "DL_T0",
            "DL_T1",
            "Domain Admins",
            "Enterprise Admins",
            "Schema Admins",
            "DnsAdmins"
          ]
        },
        {
          "Right": "SeDenyRemoteInteractiveLogonRight",
          "Description": "Deny log on through Remote Desktop",
          "Groups": [
            "DL_T0",
            "DL_T1",
            "Domain Admins",
            "Enterprise Admins",
            "Schema Admins",
            "DnsAdmins"
          ]
        },
        {
          "Right": "SeDenyNetworkLogonRight",
          "Description": "Deny access from the network",
          "Groups": [
            "DL_T0",
            "DL_T1",
            "Domain Admins",
            "Enterprise Admins",
            "Schema Admins",
            "DnsAdmins"
          ]
        },
        {
          "Right": "SeDenyBatchLogonRight",
          "Description": "Deny log on as a batch job",
          "Groups": [
            "DL_T0",
            "DL_T1",
            "Domain Admins",
            "Enterprise Admins",
            "Schema Admins",
            "DnsAdmins"
          ]
        },
        {
          "Right": "SeDenyServiceLogonRight",
          "Description": "Deny log on as a service",
          "Groups": [
            "DL_T0",
            "DL_T1",
            "Domain Admins",
            "Enterprise Admins",
            "Schema Admins",
            "DnsAdmins"
          ]
        }
      ]
    },
    {
      "Name": "SEC-Harden-RDP",
      "Description": "Enforce Network Level Authentication and strong encryption for Remote Desktop connections",
      "Enabled": true,
      "LinkTargets": null,
      "RegistrySettings": [
        {
          "Key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server\\WinStations\\RDP-Tcp",
          "ValueName": "UserAuthentication",
          "Value": 1,
          "Type": "DWord",
          "Description": "Require Network Level Authentication (NLA)"
        },
        {
          "Key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server\\WinStations\\RDP-Tcp",
          "ValueName": "SecurityLayer",
          "Value": 2,
          "Type": "DWord",
          "Description": "Use TLS 1.0+ security layer"
        },
        {
          "Key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server\\WinStations\\RDP-Tcp",
          "ValueName": "MinEncryptionLevel",
          "Value": 3,
          "Type": "DWord",
          "Description": "High encryption level for RDP connections"
        }
      ]
    },

    {
      "Name": "SEC-Tiering-T0-LocalAdmins-Servers",
      "Description": "Enforce local Administrators membership on T0 servers via Restricted Groups (replaces full membership - add any additional local admin groups to the Members array below)",
      "Enabled": true,
      "LinkTargets": "OU=Servers,OU=T0-Prod,DC=forest,DC=lol",
      "RestrictedGroups": [
        {
          "Group": "Administrators",
          "Members": ["Domain Admins", "DL_T0_Servers_LocalAdmin"],
          "Description": "Enforce local Administrators on T0 servers"
        }
      ]
    },
    {
      "Name": "SEC-Tiering-T0-LocalAdmins-PAWs",
      "Description": "Enforce local Administrators membership on T0 PAWs via Restricted Groups (replaces full membership - add any additional local admin groups to the Members array below)",
      "Enabled": true,
      "LinkTargets": "OU=PAWs,OU=T0-Prod,DC=forest,DC=lol",
      "RestrictedGroups": [
        {
          "Group": "Administrators",
          "Members": ["Domain Admins", "DL_T0_PAWs_LocalAdmin"],
          "Description": "Enforce local Administrators on T0 PAWs"
        }
      ]
    },
    {
      "Name": "SEC-Tiering-T1-LocalAdmins-Servers",
      "Description": "Enforce local Administrators membership on T1 servers via Restricted Groups (replaces full membership - add any additional local admin groups to the Members array below)",
      "Enabled": true,
      "LinkTargets": "OU=Servers,OU=T1-Prod,DC=forest,DC=lol",
      "RestrictedGroups": [
        {
          "Group": "Administrators",
          "Members": ["DL_T1_Servers_LocalAdmin"],
          "Description": "Enforce local Administrators on T1 servers"
        }
      ]
    },
    {
      "Name": "SEC-Tiering-T2-LocalAdmins-Workstations",
      "Description": "Enforce local Administrators membership on T2 workstations via Restricted Groups (replaces full membership - add any additional local admin groups to the Members array below)",
      "Enabled": true,
      "LinkTargets": "OU=Workstations,OU=T2-Prod,DC=forest,DC=lol",
      "RestrictedGroups": [
        {
          "Group": "Administrators",
          "Members": ["DL_T2_Workstations_LocalAdmin"],
          "Description": "Enforce local Administrators on T2 workstations"
        }
      ]
    }
  ]
}
